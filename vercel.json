{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run tokens:check",
  "outputDirectory": ".",
  "functions": {
    "api/**": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/keepalive", "schedule": "0 6 * * *" }
  ],
  "redirects": [
    { "source": "/discover", "destination": "/wall", "permanent": false },
    { "source": "/discover.html", "destination": "/wall", "permanent": false },
    { "source": "/foryou", "destination": "/wall", "permanent": false },
    { "source": "/create", "destination": "/seal-a-piece", "permanent": false },
    { "source": "/login", "destination": "/join", "permanent": false },
    { "source": "/studio", "destination": "/#studio", "permanent": false },
    { "source": "/market", "destination": "/wall", "permanent": false },
    { "source": "/market.html", "destination": "/wall", "permanent": false },
    { "source": "/SecurityArts%20Design%20System/:path*", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]?__path=$1" },
    { "source": "/wall", "destination": "/wall.html" },
    { "source": "/join", "destination": "/join.html" },
    { "source": "/seal-a-piece", "destination": "/seal-a-piece.html" },
    { "source": "/seal/:id([A-Za-z0-9_-]+)", "destination": "/certificate.html?work=:id" },
    { "source": "/@:handle([A-Za-z0-9_]{1,30})", "destination": "/profile.html?h=:handle" },
    { "source": "/verify", "destination": "/verify.html" },
    { "source": "/me", "destination": "/me.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/services/penetration-testing", "destination": "/services-penetration-testing.html" },
    { "source": "/services/application-security", "destination": "/services-application-security.html" },
    { "source": "/services/cloud-infrastructure", "destination": "/services-cloud-infrastructure.html" },
    { "source": "/services/detection-response", "destination": "/services-detection-response.html" },
    { "source": "/services/security-architecture", "destination": "/services-security-architecture.html" },
    { "source": "/services/advisory-training", "destination": "/services-advisory-training.html" },
    { "source": "/verified", "destination": "/verified.html" },
    { "source": "/compare/ai-detectors", "destination": "/vs-ai-detectors.html" },
    { "source": "/compare/c2pa", "destination": "/vs-c2pa.html" },
    { "source": "/compare/not-by-ai", "destination": "/vs-not-by-ai.html" },
    { "source": "/prove-your-art-is-human", "destination": "/how-to-prove-your-art-is-human.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.posthog.com https://*.clerk.accounts.dev https://challenges.cloudflare.com https://*.protect.clerk.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://ixdkfakibuctwhgwngsw.supabase.co https://img.clerk.com; connect-src 'self' https://*.posthog.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io https://*.clerk.accounts.dev https://*.protect.clerk.com:*; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com https://*.protect.clerk.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
      ]
    }
  ]
}
