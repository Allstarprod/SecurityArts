# SecurityArts server configuration — copy to .env and load with your process manager.
# The server reads process.env directly (no dotenv dependency).

# Port to listen on.
PORT=8137

# HMAC key for signing session cookies. REQUIRED in production — generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, a key is auto-generated and persisted to server/data/session.secret (dev convenience).
SESSION_SECRET=

# Set to 1 when running behind a TLS terminator (nginx, Caddy, a cloud LB).
# Emits Strict-Transport-Security and marks the session cookie Secure.
TRUST_PROXY_HTTPS=0

# Set to 1 ONLY when behind a proxy you operate that sets X-Forwarded-For.
# When 1, the client IP (used for rate limiting + audit) is read from the first
# X-Forwarded-For hop; when 0 (default) it comes from the socket, so a directly
# exposed server cannot be tricked into trusting a spoofed IP header.
TRUST_PROXY=0

# ── Storage backend ───────────────────────────────────────────────────────────
# file     = local JSON + blob files (default; single process; great for dev / small).
# postgres = Postgres/Supabase (shared across instances; required to scale out).
# If unset: postgres when DATABASE_URL is present, otherwise file.
DB_DRIVER=file

# Postgres/Supabase connection string. From Supabase: Project Settings → Database →
# Connection string → URI (use the "Connection pooling" / pgBouncer URL for many instances).
#   postgresql://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# Apply schema.sql automatically on first boot (dev convenience). In prod, run
# schema.sql once via the Supabase SQL editor instead and leave this at 0.
DB_AUTO_MIGRATE=0

# Postgres connection pool size PER INSTANCE. Keep instances*PG_POOL_MAX under your
# DB's connection cap (Supabase free tier ≈ 60; use the pooler URL for more).
PG_POOL_MAX=10

# Set 0 to disable TLS to Postgres (local dev only). Default: TLS on.
PG_SSL=1

# ── Rate limiting ─────────────────────────────────────────────────────────────
# memory   = per-process (correct for ONE instance / one clustered box).
# postgres = shared counters in the rate_limits table (correct across many instances).
RATELIMIT_DRIVER=memory

# ── Supabase Storage (images → CDN) ──────────────────────────────────────────
# When BOTH are set, published images upload to the (public) SUPABASE_BUCKET and
# works carry a CDN URL instead of base64 in the DB — the biggest win for RAM,
# DB size, and egress at scale. Unset = images stored via the DB driver as before.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=work-images

# ── Clustering ────────────────────────────────────────────────────────────────
# Run multiple worker processes on one box to use all cores. Needs DB_DRIVER=postgres
# (the file driver is single-process). "max" = all cores, or set a number (e.g. 4).
CLUSTER=
