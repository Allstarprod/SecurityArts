{
  "name": "securityarts-site",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SecurityArts monorepo root — page build tooling (JSX precompile, vendored React). The runtime server lives in server/.",
  "engines": { "node": "22.x" },
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "build:check": "node scripts/build-pages.mjs --check",
    "tokens": "node design-system/build-tokens.mjs",
    "tokens:check": "node design-system/build-tokens.mjs --check",
    "test:tokens": "node --test design-system/build-tokens.test.mjs",
    "test:pages": "node --test scripts/pages.test.mjs"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
